{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "c_zipper",
  "main": "src/index.js",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "browser": {
    "binding": "MYBROWSER"
  },
  "assets": {
    "directory": "./public"
  },
  "kv_namespaces": [
    { "binding": "GC_HISTORY", "id": "91caf15349a146e9ba23ef1a69165b59" }
  ],
  "vars": {
    "GH_OWNER": "v1-byte",
    "GH_REPO": "C_Ziperr",
    "GH_WORKFLOW": "collect.yml",
    "PUBLIC_APP_NAME": "Game Collector Pro",
    "OPENROUTER_MODEL": "openrouter/free",
    "OPENROUTER_SITE_URL": "https://c_zipper.corelink-ai.workers.dev",
    "EDU_GH_OWNER": "frostbyte-lab",
    "EDU_GH_REPO": "Edu-network",
    "EDU_GH_BRANCH": "main",
    "EDU_PAGES_URL": "https://ea29118c.edu-network.pages.dev"
  }
}
